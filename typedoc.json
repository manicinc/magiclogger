{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "entryPointStrategy": "expand",
  "out": "website/static/api",
  "exclude": [
    "**/node_modules/**",
    "**/tests/**",
    "**/examples/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "tsconfig": "./tsconfig.json",
  "readme": "README.md",
  "githubPages": false,
  "disableSources": false,
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeInternal": false,
  "excludeExternals": false,
  "includeVersion": true,
  "categorizeByGroup": true,
  "defaultCategory": "Other",
  "categoryOrder": [
    "Core",
    "Transports",
    "Types",
    "Extensions",
    "Utils",
    "*"
  ],
  "navigationLinks": {
    "🏠 Home": "https://magiclog.io",
    "📖 Documentation": "https://magiclog.io/docs/intro",
    "GitHub": "https://github.com/manicinc/magiclogger"
  },
  "sidebarLinks": {
    "🏠 Home": "https://magiclog.io",
    "📖 Documentation": "https://magiclog.io/docs/intro"
  },
  "theme": "default",
  "hideGenerator": false,
  "skipErrorChecking": false,
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": false
  }
}