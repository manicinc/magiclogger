{
  "name": "magiclogger-benchmarks",
  "version": "1.0.0",
  "description": "Performance benchmarks for MagicLogger vs popular logging libraries",
  "type": "module",
  "main": "perf-bench.mjs",
  "scripts": {
    "bench": "node perf-bench.mjs",
    "bench:ts": "tsx perf-bench.ts",
  "perf:update": "pnpm run build && tsx perf-bench.ts || node perf-bench.mjs",
    "install-deps": "npm install pino winston bunyan pino-pretty",
    "test": "node perf-bench.mjs"
  },
  "keywords": [
    "benchmark",
    "logging",
    "performance",
    "magiclogger",
    "pino",
    "winston",
    "bunyan"
  ],
  "author": "MagicLogger Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/bunyan": "^1.8.11",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  ,"chalk": "^5.3.0"
  },
  "optionalDependencies": {
    "pino": "^8.16.0",
    "winston": "^3.11.0",
    "bunyan": "^1.8.15",
    "pino-pretty": "^10.2.0"
  },
  "dependencies": {},
  "engines": {
    "node": ">=16"
  }
}