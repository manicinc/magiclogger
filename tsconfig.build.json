{
    "extends": "./tsconfig.json",
    "compilerOptions": {
      "declaration": true,
      "declarationMap": false,
      "emitDeclarationOnly": false,
      "outDir": "./dist",
      "module": "ESNext",                  // Ideal for tsup – will be bundled
      "moduleResolution": "Bundler",      // Avoid ESM .js extension noise
      "allowJs": false,
      "checkJs": false,
      "noEmit": false,
      "rootDir": "./src",                 // Only compile real source
      "composite": false,                 // Not needed for tsup builds
    },
    "include": ["src/**/*"],
    "exclude": ["tests", "examples", "node_modules", "dist"]
  }
  