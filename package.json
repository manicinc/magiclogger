  "sideEffects": false,
  "files": [
    "dist",
    "!dist/examples",
    "!dist/**/*.map",
    "!dist/metafile-*.json"
  ],
  "scripts": {
    "demo": "npx tsx examples/animated-demo.ts",
    "demo:guided": "npx tsx examples/guided-animated-demo.ts",
    "demo:tree-shaking": "npx tsx examples/tree-shaking-demo.ts",
    "demo:web": "npm run build && node -e \"const fs = require('fs-extra'); fs.copySync('dist', 'examples/web-demo/dist')\" && serve examples/web-demo",
    "docs": "npm run docs:start",
    "docs:start": "cd website && npm start",
    "docs:build": "npm run build && cd website && npm ci && npm run build",
    "docs:serve": "cd website && npm run serve",
    "docs:deploy": "cd website && npm run deploy",
    "docs:install": "cd website && npm ci",
    "clean": "rimraf dist test_logs .tsbuildinfo",
    "check": "npm run format && npm run lint",
    "dev": "tsup --watch",
    "build": "npm run clean && tsup && tsup --platform=browser --entry.src=src/index.browser.ts",
    "build:analyze": "npm run build && npm run analyze:build",
    "build:examples": "tsup examples/*.ts --format=cjs --outDir=dist/examples",
    "build:examples:esm": "tsup examples/*.ts --format=esm --outDir=dist/examples --outExtension='.mjs'",
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand --ci --detectOpenHandles --coverageReporters=text --coverageReporters=lcov --coverageReporters=json --coverageReporters=json-summary --coverageReporters=clover --coverageReporters=html --forceExit",
    "test:treeshake": "node scripts/test-tree-shaking.js",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,json}\" \"tests/**/*.{ts,json}\" \"examples/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\" \"tests/**/*.{ts,json}\" \"examples/**/*.{ts,json}\"",
    "validate": "npm run format:check && npm run lint",
    "commit": "cz",
    "test:coverage:badge": "node scripts/generate-coverage-badge.js",
    "analyze:build": "node scripts/analyze-build.js",
    "perf:run": "npm run build && node scripts/performance/perf-bench.mjs",
    "perf:run:ts": "npm run build && tsx scripts/performance/perf-bench.ts",
    "perf:update": "node scripts/update-perf-table.js",
    "version:bump": "node scripts/version-bump.js",
    "preflight": "npm run clean && npm run check && npm run lint && npm run test:coverage && npm run build && npm run test:coverage:badge && npm run analyze:build && npm run test:treeshake",
    "prepublishOnly": "npm run test && npm run lint && npm run build && npm run test:coverage:badge && npm run analyze:build",
    "prepare": "npm run clean && husky",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags",
    "release:manual": "npm run preflight && npm run version:bump",
    "security:audit": "pnpm audit || true",
    "security:deps": "npx license-checker --summary",
    "security:lock": "npx lockfile-lint --path pnpm-lock.yaml --type pnpm --validate-https",
    "deps:graph": "dependency-cruiser -T html src --output dependency-graph.html",
    "deps:graph:json": "dependency-cruiser -T json src > dependency-graph.json",
    "size:check": "node scripts/analyze-build.js --check",
    "size:update": "node scripts/analyze-build.js",
    "clean:deep": "rimraf dist build lib coverage tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo \"node_modules/.cache\" && pnpm exec jest --clearCache || true",
    "rebuild": "npm run clean:deep && pnpm install && npm run build"
  },
  "keywords": [
    "logger",
    "terminal",
    "color",
    "console",
    "log",
    "styled",
    "formatting",
    "ansi",
    "tree-shakeable",
    "zero-dependency",
    "typescript",
    "structured-logging",
    "transports",
    "browser",
    "node"
  ],
  "author": "Manic.agency",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manicinc/magiclogger.git"
