{
  "name": "magiclogger",
  "version": "0.1.0",
  "description": "Magical terminal logger with color support, file logging, and numerous formatting options",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/examples"
  ],
  "scripts": {
    "clean": "rimraf dist test_logs .tsbuildinfo",
    "dev": "tsup --watch",
    "build": "npm run clean && tsup",
    "build:examples": "tsup examples/*.ts --format=cjs --outDir=dist/examples",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "npm run clean && husky",
    "prepublishOnly": "npm test && npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags",
    "commit": "cz"
  },
  "keywords": [
    "logger",
    "terminal",
    "color",
    "console",
    "log",
    "styled",
    "formatting",
    "ansi"
  ],
  "author": "Manic.agency",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manicinc/advanced-logger.git"
  },
  "bugs": {
    "url": "https://github.com/manicinc/advanced-logger/issues"
  },
  "homepage": "https://github.com/manicinc/advanced-logger#readme",
  "devDependencies": {
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "@jest/globals": "^29.7.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^10.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.0.4",
    "@semantic-release/npm": "^10.0.5",
    "@semantic-release/release-notes-generator": "^11.0.7",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.19.84",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.38.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^27.4.0",
    "fs-extra": "^11.3.0",
    "husky": "^9.0.11",
    "jest": "^29.5.0",
    "lint-staged": "^15.2.0",
    "path-browserify": "^1.0.1",
    "prettier": "^2.8.7",
    "rimraf": "^6.0.1",
    "semantic-release": "^21.0.7",
    "ts-jest": "^29.1.0",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.0.1",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
