    "husky": "^9.0.11",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.0",
    "path-browserify": "^1.0.1",
    "prettier": "^2.8.7",
    "pretty-bytes": "^6.0.1",
    "rimraf": "^6.0.1",
    "semantic-release": "^21.0.7",
    "serve": "^14.2.4",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.0.4",
    "esbuild": "^0.25.0",
    "dependency-cruiser": "^16.6.0",
    "license-checker": "^25.0.1",
    "lockfile-lint": "4.14.1",
    "eslint-plugin-security": "^2.1.1"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "aws-sdk": "^2.0.0",
    "mongodb": "^4.0.0 || ^5.0.0 || ^6.0.0",
