{
  "name": "magiclogger",
  "version": "0.1.0",
  "description": "Lightweight magical terminal and browser-compatible logger with color support, file logging, and numerous formatting options",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "!dist/examples"
  ],
  "scripts": {
    "demo": "npx tsx examples/animated-demo.ts",
    "demo:guided": "npx tsx examples/guided-animated-demo.ts",
    "demo:web": "npm run build && node -e \"const fs = require('fs-extra'); fs.copySync('dist', 'examples/web-demo/dist')\" && serve examples/web-demo",
    "docs:api": "typedoc",
    "docs:build": "npm run docs:api && cd website && npm run build",
    "docs:dev": "npm run docs:api && cd website && npm start",
    "clean": "rimraf dist test_logs .tsbuildinfo website/static/api",
    "check": "npm run format && npm run lint",
    "dev": "tsup --watch",
    "build": "npm run clean && tsup",
    "build:examples": "tsup examples/*.ts --format=cjs --outDir=dist/examples",
    "build:examples:esm": "tsup examples/*.ts --format=esm --outDir=dist/examples --outExtension='.mjs'",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,json}\" \"tests/**/*.{ts,json}\" \"examples/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\" \"tests/**/*.{ts,json}\" \"examples/**/*.{ts,json}\"",
    "validate": "npm run format:check && npm run lint",
    "commit": "cz",
    "test:coverage:badge": "node scripts/generate-coverage-badge.js",
    "analyze:build": "node scripts/analyze-build.js",
    "version:bump": "node scripts/version-bump.js",
    "preflight": "npm run clean && npm run check && npm run lint && npm run test:coverage && npm run build && npm run test:coverage:badge && npm run analyze:build",
    "prepublishOnly": "npm run test && npm run lint && npm run build && npm run test:coverage:badge && npm run analyze:build",
    "prepare": "npm run clean && husky",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags",
    "release:manual": "npm run preflight && npm run version:bump"
  },
  "keywords": [
    "logger",
    "terminal",
    "color",
    "console",
    "log",
    "styled",
    "formatting",
    "ansi"
  ],
  "author": "Manic.agency",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manicinc/advanced-logger.git"
  },
  "bugs": {
    "url": "https://github.com/manicinc/advanced-logger/issues"
  },
  "homepage": "https://github.com/manicinc/advanced-logger#readme",
  "devDependencies": {
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "@jest/globals": "^29.7.0",
    "@octokit/rest": "^21.1.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^10.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.0.4",
    "@semantic-release/npm": "^10.0.5",
    "@semantic-release/release-notes-generator": "^11.0.7",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.19.84",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.38.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^27.4.0",
    "fs-extra": "^11.3.0",
    "husky": "^9.0.11",
    "jest": "^29.5.0",
    "lint-staged": "^15.2.0",
    "path-browserify": "^1.0.1",
    "prettier": "^2.8.7",
    "pretty-bytes": "^6.0.1",
    "rimraf": "^6.0.1",
    "semantic-release": "^21.0.7",
    "serve": "^14.2.4",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typedoc": "^0.28.7",
    "typedoc-plugin-markdown": "^4.7.0",
    "typescript": "^5.0.4"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
