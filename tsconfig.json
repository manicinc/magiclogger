{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
  "moduleResolution": "node",
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "magiclogger": ["./src/index.ts"],
      "magiclogger/*": ["./src/*"],
      // Explicit aliases to support Bundler resolution (no implicit index resolution)
  "magiclogger/core/StyleBuilder": ["./src/core/StyleBuilder.ts"],
  "magiclogger/core/Colorizer": ["./src/core/Colorizer.ts"],
      "magiclogger/types": ["./src/types/index.ts"],
      "magiclogger/constants/themes": ["./src/constants/themes.ts"]
    },
    // Include Jest types so test files have proper globals in the editor
    "types": ["node", "jest"],
    "outDir": "./dist",
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true
  },
  "include": ["src/**/*.ts", "examples/**/*.ts", "tests/**/*.ts"]
}
